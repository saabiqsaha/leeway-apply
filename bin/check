#!/usr/bin/env python3
"""bin/check: is the brain ready, and what should the agent do next?

Prints a readiness report and ends with one line, MODE: onboarding | run | refill.
Exit code 0 when ready to apply, 2 when onboarding is needed.
"""
import json
import sys
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import leeway  # noqa: E402

# Values that only exist in profile.example/: if any survive, the brain is not filled in.
# Matched against whole field values, so a real "Adam" or "Canada" never trips it.
PLACEHOLDERS = {"Ada", "Lovelace", "ada@example.com", "5555550123", "123 Main Street",
                "Example State University", "62701"}


def leaves(obj):
    if isinstance(obj, dict):
        for v in obj.values():
            yield from leaves(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from leaves(v)
    elif isinstance(obj, str):
        yield obj


ANSWER_PLACEHOLDERS = ["Example State", "Paste a short, real cover letter here", "**Project name**"]


def ok(msg):
    print(f"  ok    {msg}")


def bad(msg):
    print(f"  TODO  {msg}")


def main():
    problems = []
    print("leeway-apply check")
    pdir = leeway.PROFILE_DIR

    pj = pdir / "profile.json"
    if not pj.exists():
        bad("profile/profile.json missing (run bin/setup)")
        problems.append("profile")
    else:
        try:
            prof = leeway.load_profile()
        except json.JSONDecodeError as e:
            bad(f"profile/profile.json is not valid JSON: {e}")
            problems.append("profile")
            prof = {}
        left = sorted({v for v in leaves(prof) if v in PLACEHOLDERS or "your-handle" in v})
        if left:
            bad(f"profile.json still has template values: {', '.join(left)}")
            problems.append("profile")
        elif prof:
            who = prof.get("identity", {})
            ok(f"profile.json filled ({who.get('first_name', '?')} {who.get('last_name', '?')}, cycle {prof.get('search', {}).get('cycle', '?')})")

    ans = pdir / "answers.md"
    if not ans.exists():
        bad("profile/answers.md missing")
        problems.append("answers")
    else:
        left = [p for p in ANSWER_PLACEHOLDERS if p in ans.read_text()]
        if left:
            bad("answers.md is still the template (pitch, projects, why-us lines)")
            problems.append("answers")
        else:
            ok("answers.md written")

    if pj.exists() and "profile" not in problems:
        rp = leeway.resume_path()
        if not rp.exists():
            bad(f"resume not found at {rp}")
            problems.append("resume")
        elif not rp.read_bytes()[:5].startswith(b"%PDF"):
            bad(f"{rp.name} is not a PDF")
            problems.append("resume")
        else:
            ok(f"resume {rp.name} ({rp.stat().st_size // 1024} KB)")

    dna = leeway.do_not_apply()
    ok(f"do_not_apply.txt: {len(dna)} compan{'y' if len(dna) == 1 else 'ies'}")

    mf = pdir / "missing_facts.md"
    open_q = [l for l in mf.read_text().splitlines() if l.startswith("- [ ]")] if mf.exists() else []
    if open_q:
        bad(f"{len(open_q)} unanswered question(s) in profile/missing_facts.md: ask the human")
    else:
        ok("no missing facts waiting")

    port = leeway.env("CDP_PORT", "9333")
    try:
        urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=2)
        ok(f"Chrome up on CDP {port}")
    except Exception:
        print(f"  --    Chrome not running on CDP {port} (bin/chrome starts it)")

    pw = leeway.REPO / ".tools" / "node_modules" / "playwright-core"
    ok("playwright-core installed") if pw.exists() else bad("playwright-core missing (run bin/setup)")

    con = leeway.db()
    ready = con.execute(
        "SELECT COUNT(*) FROM apply_queue aq JOIN postings p ON aq.posting_id=p.id "
        "WHERE aq.claimed_by IS NULL AND aq.completed_at IS NULL AND p.status='new'"
    ).fetchone()[0]
    applied = con.execute("SELECT COUNT(*) FROM applications").fetchone()[0]
    ok(f"queue: {ready} ready, {applied} applied all time")

    if problems:
        print("\nMODE: onboarding")
        sys.exit(2)
    print("\nMODE: run" if ready else "\nMODE: refill")


if __name__ == "__main__":
    main()
